# Copy to .env (never commit .env). `museos setup` writes the key lines for you.

# Database. Default: a SQLite file (museos.db) in the folder you start MuseOS from. Nothing to install.
# For PostgreSQL: uv sync --extra postgres, then set e.g. postgresql+asyncpg://localhost:5432/museos
MUSEOS_DATABASE_URL=

# Provider file. Default: ./providers.toml if it exists, otherwise built-in demo models.
# MUSEOS_PROVIDERS_FILE=providers.toml

MUSEOS_RETRY_BACKOFF_S=0.25
# The API has no login: it only answers these Host names, and caps the budget any caller can request.
MUSEOS_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MUSEOS_MAX_BUDGET_USD=2.0
# Kill switch for external writes. No connector exists yet; keep false.
MUSEOS_EXTERNAL_WRITES_ENABLED=false
MUSEOS_DESTINATION_ALLOWLIST=

# Provider keys, referenced by api_key_env in providers.toml
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
