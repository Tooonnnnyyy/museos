# Copy to .env (never commit .env). `swarmos setup` writes the key lines for you.

# Database. Default: a SQLite file (swarmos.db) in the folder you start SwarmAgentOS from. Nothing to install.
# For PostgreSQL: uv sync --extra postgres, then set e.g. postgresql+asyncpg://localhost:5432/swarmos
SWARMOS_DATABASE_URL=

# Provider file. Default: ./providers.toml if it exists, otherwise built-in demo models.
# SWARMOS_PROVIDERS_FILE=providers.toml

SWARMOS_RETRY_BACKOFF_S=0.25
# The API has no login: it only answers these Host names, and caps the budget any caller can request.
SWARMOS_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
SWARMOS_MAX_BUDGET_USD=2.0
# Kill switch for external writes. No connector exists yet; keep false.
SWARMOS_EXTERNAL_WRITES_ENABLED=false
SWARMOS_DESTINATION_ALLOWLIST=

# Provider keys, referenced by api_key_env in providers.toml
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Authentication (on by default). Sign up at /login; sessions live in the database.
# Set SWARMOS_AUTH_ENABLED=false to restore the old single-user, no-login behavior.
SWARMOS_AUTH_ENABLED=true
SWARMOS_SESSION_TTL_DAYS=30
